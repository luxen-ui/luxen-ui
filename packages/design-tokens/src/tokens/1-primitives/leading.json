{
  "$description": "Line-height primitives. Vendored from Tailwind v4 default theme (`leading-*` family).",
  "$extensions": {
    "com.luxen-ui": {
      "tier": "primitive"
    }
  },
  "leading-tight": {
    "$type": "number",
    "$value": "1.25"
  },
  "leading-snug": {
    "$type": "number",
    "$value": "1.375"
  },
  "leading-normal": {
    "$type": "number",
    "$value": "1.5"
  },
  "leading-relaxed": {
    "$type": "number",
    "$value": "1.625"
  },
  "leading-loose": {
    "$type": "number",
    "$value": "2"
  }
}
