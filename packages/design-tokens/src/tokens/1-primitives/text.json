{
  "$description": "Font-size primitives + paired line-height tokens. Vendored from Tailwind v4 default theme. Naming follows Tailwind's double-dash subkey convention: `--l-text-xs--line-height`.",
  "text-xs": {
    "$type": "dimension",
    "$value": "0.75rem"
  },
  "text-xs--line-height": {
    "$type": "dimension",
    "$value": "calc(1 / 0.75)"
  },
  "text-sm": {
    "$type": "dimension",
    "$value": "0.875rem"
  },
  "text-sm--line-height": {
    "$type": "dimension",
    "$value": "calc(1.25 / 0.875)"
  },
  "text-base": {
    "$type": "dimension",
    "$value": "1rem"
  },
  "text-base--line-height": {
    "$type": "dimension",
    "$value": "calc(1.5 / 1)"
  },
  "text-lg": {
    "$type": "dimension",
    "$value": "1.125rem"
  },
  "text-lg--line-height": {
    "$type": "dimension",
    "$value": "calc(1.75 / 1.125)"
  },
  "text-xl": {
    "$type": "dimension",
    "$value": "1.25rem"
  },
  "text-xl--line-height": {
    "$type": "dimension",
    "$value": "calc(1.75 / 1.25)"
  },
  "text-2xl": {
    "$type": "dimension",
    "$value": "1.5rem"
  },
  "text-2xl--line-height": {
    "$type": "dimension",
    "$value": "calc(2 / 1.5)"
  },
  "text-3xl": {
    "$type": "dimension",
    "$value": "1.875rem"
  },
  "text-3xl--line-height": {
    "$type": "dimension",
    "$value": "calc(2.25 / 1.875)"
  },
  "text-4xl": {
    "$type": "dimension",
    "$value": "2.25rem"
  },
  "text-4xl--line-height": {
    "$type": "dimension",
    "$value": "calc(2.5 / 2.25)"
  },
  "text-5xl": {
    "$type": "dimension",
    "$value": "3rem"
  },
  "text-5xl--line-height": {
    "$type": "dimension",
    "$value": "1"
  },
  "text-6xl": {
    "$type": "dimension",
    "$value": "3.75rem"
  },
  "text-6xl--line-height": {
    "$type": "dimension",
    "$value": "1"
  },
  "text-7xl": {
    "$type": "dimension",
    "$value": "4.5rem"
  },
  "text-7xl--line-height": {
    "$type": "dimension",
    "$value": "1"
  },
  "text-8xl": {
    "$type": "dimension",
    "$value": "6rem"
  },
  "text-8xl--line-height": {
    "$type": "dimension",
    "$value": "1"
  },
  "text-9xl": {
    "$type": "dimension",
    "$value": "8rem"
  },
  "text-9xl--line-height": {
    "$type": "dimension",
    "$value": "1"
  }
}
